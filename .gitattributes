# ==============================================================================
# Git Attributes - Line Endings & Language Handling
# ==============================================================================

# Default behavior: normalize line endings to LF
* text=auto eol=lf

# C++ Source and Header files
*.cxx text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.cc  text eol=lf diff=cpp
*.hxx text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.h   text eol=lf diff=cpp

# Build system & scripts
CMakeLists.txt text eol=lf
*.cmake        text eol=lf
Makefile       text eol=lf
*.sh           text eol=lf
*.bash         text eol=lf

# Documentation & Config
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cff  text eol=lf

# Binary formats
*.vtu binary
*.vtk binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.tar.gz binary
*.zip binary
