# Doxyfile configuration for ParticleSimulation
# Génère la documentation dans doc/html/

PROJECT_NAME           = "Simulation de Particules"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "C++ pour les Mathématiques Appliquées — ENSIMAG MMIS 2A"

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@
INPUT                  = @CMAKE_SOURCE_DIR@/include @CMAKE_SOURCE_DIR@/src
RECURSIVE              = YES
FILE_PATTERNS          = *.hxx *.cxx *.txx

EXTRACT_ALL            = YES
